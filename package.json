{
  "name": "diff-cov",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:commit": "commitlint --edit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "publish:first": "pnpm build && pnpm -r publish --access public --no-git-checks",
    "example:coverage": "pnpm --filter diff-cov-example-vitest-app run test:coverage",
    "example:diff-cov": "pnpm --filter @diff-cov/cli run build && node packages/cli/dist/index.js --cwd examples/vitest-app --base auto --threshold 90"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}

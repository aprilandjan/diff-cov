{
  "name": "diff-cov",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "example:coverage": "pnpm --filter diff-cov-example-vitest-app run test:coverage",
    "example:diff-cov": "pnpm --filter diff-cov-cli run build && node packages/cli/dist/index.js --cwd examples/vitest-app --base auto --threshold 90"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}

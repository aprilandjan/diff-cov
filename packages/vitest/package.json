{
  "name": "@diff-cov/vitest",
  "version": "0.0.0",
  "description": "Vitest 4 reporter for diff coverage.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@diff-cov/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=4.1.0 <5"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.9"
  }
}
